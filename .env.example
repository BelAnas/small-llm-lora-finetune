# Which system routes messages: local (the fine-tuned model), mock (offline rules), openai (hosted).
TRIAGE_PROVIDER=local
# The open base model the LoRA add-on was trained on.
TRIAGE_BASE_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
# Folder that holds the trained LoRA add-on.
TRIAGE_ADAPTER_DIR=adapter
# CPU threads used by PyTorch (0 = let PyTorch decide).
TRIAGE_THREADS=0
# Only for TRIAGE_PROVIDER=openai, the optional hosted comparison.
OPENAI_API_KEY=
OPENAI_MODEL=
